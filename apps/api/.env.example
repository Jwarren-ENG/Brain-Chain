# BrainChain API configuration. Copy to .env (never commit .env).
# All variables are prefixed BRAINCHAIN_ and read by app/config.py.

# --- Core -------------------------------------------------------------------
# Default (unset): SQLite file at the repo root — zero-dependency dev mode.
# Full profile: postgresql+psycopg://brainchain:<password>@localhost:5432/brainchain
# BRAINCHAIN_DATABASE_URL=

# Session signing / security. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BRAINCHAIN_SECRET_KEY=dev-only-secret-change-me
BRAINCHAIN_SESSION_TTL_HOURS=12

# --- Deployment profile -----------------------------------------------------
# government | commercial | private.  "government" hard-disables external
# model calls regardless of any other setting.
BRAINCHAIN_DEPLOYMENT_PROFILE=commercial
BRAINCHAIN_ALLOW_EXTERNAL_MODEL_CALLS=false

# --- Privacy ----------------------------------------------------------------
# Floor for the anonymous-feedback cohort (org setting can raise it).
BRAINCHAIN_MIN_FEEDBACK_COHORT=5
# Keep false unless policy explicitly allows storing raw prompt text in audit.
BRAINCHAIN_LOG_RAW_PROMPTS=false

# --- Model gateway (optional external provider) ------------------------------
# The local mock provider needs nothing. To enable an OpenAI-compatible
# endpoint, set all three AND enable external models in org settings AND have
# a routing policy whose classification ceiling permits the content:
# BRAINCHAIN_OPENAI_BASE_URL=https://api.openai.com/v1
# BRAINCHAIN_OPENAI_API_KEY=
# BRAINCHAIN_OPENAI_MODEL=gpt-4o-mini

# --- Web --------------------------------------------------------------------
BRAINCHAIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
